// Zellij config — set up to mirror our .tmux.conf in this repo.
//
// tmux feel: Ctrl a is THE prefix and does everything. Press Ctrl a, then a
// single key, just like tmux:
//   Ctrl a c        new tab (window)        Ctrl a "        split down
//   Ctrl a n / p    next / prev tab         Ctrl a %        split right
//   Ctrl a 1..9     go to tab N             Ctrl a x        close pane
//   Ctrl a ,        rename tab              Ctrl a &        close tab
//   Ctrl a z        zoom (fullscreen)       Ctrl a [        scroll/copy mode
//   Ctrl a h/j/k/l  move focus              Ctrl a d        detach
//   Ctrl a o        next pane               Ctrl a space    next layout
//   Ctrl a Ctrl a   send a literal Ctrl a   Ctrl a r        resize mode
//   Ctrl a v        toggle pane sync        Ctrl a w        session manager
//
// Other tmux mappings:
//   set -g mouse on     -> mouse_mode true
//   mode-keys vi        -> vi-style hjkl scroll/navigation
//   history-limit 20000 -> scroll_buffer_size 20000
//   S-Left/S-Right      -> prev/next tab globally (no prefix)
//   F12 keybinding off  -> Ctrl g toggles Locked mode (pass keys to a nested
//                          session / remote multiplexer)
//   minimal status bar  -> compact-bar, no pane frames, simplified UI

ui {
    pane_frames {
        hide_session_name true
    }
}

keybinds clear-defaults=true {
	normal {
		// Free up keys we don't rebind so they pass through to the shell.
		unbind "Ctrl p"
		unbind "Ctrl o"
		unbind "Ctrl q"
		unbind "Ctrl h"
	}
	locked {
		// Mirrors tmux's F12 "key-table off": Ctrl g releases all bindings so
		// keys go straight to a nested/remote session. Ctrl g again restores.
		bind "Ctrl g" { SwitchToMode "Normal"; }
	}

	// The one and only prefix mode: tmux's "Ctrl a, then a key". Every binding
	// performs its action and drops straight back to Normal, like tmux.
	tmux {
		// Ctrl a Ctrl a -> send a literal Ctrl a to the running program
		// (tmux: send-prefix).
		bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }
		bind "Esc" { SwitchToMode "Normal"; }

		// Tabs / windows.
		bind "c" { NewTab; SwitchToMode "Normal"; }
		bind "n" { GoToNextTab; SwitchToMode "Normal"; }
		bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
		bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
		bind "&" { CloseTab; SwitchToMode "Normal"; }
		bind "1" { GoToTab 1; SwitchToMode "Normal"; }
		bind "2" { GoToTab 2; SwitchToMode "Normal"; }
		bind "3" { GoToTab 3; SwitchToMode "Normal"; }
		bind "4" { GoToTab 4; SwitchToMode "Normal"; }
		bind "5" { GoToTab 5; SwitchToMode "Normal"; }
		bind "6" { GoToTab 6; SwitchToMode "Normal"; }
		bind "7" { GoToTab 7; SwitchToMode "Normal"; }
		bind "8" { GoToTab 8; SwitchToMode "Normal"; }
		bind "9" { GoToTab 9; SwitchToMode "Normal"; }

		// Splits (tmux: " down, % right).
		bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
		bind "%" { NewPane "Right"; SwitchToMode "Normal"; }

		// Pane focus / management.
		bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
		bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
		bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
		bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
		bind "o" { FocusNextPane; SwitchToMode "Normal"; }
		bind "x" { CloseFocus; SwitchToMode "Normal"; }
		bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
		bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
		bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
		// tmux: bind v setw synchronize-panes
		bind "v" { ToggleActiveSyncTab; SwitchToMode "Normal"; }

		// Layout / session.
		bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
		bind "d" { Detach; }
		bind "w" {
		    LaunchOrFocusPlugin "zellij:session-manager" {
			floating true
			move_to_focused_tab true
		    };
		    SwitchToMode "Normal"
		}

		// Sub-modes reached through the prefix (these stay until you exit them).
		bind "[" { SwitchToMode "Scroll"; }
		bind "r" { SwitchToMode "Resize"; }
	}

	resize {
		bind "Ctrl n" "Esc" { SwitchToMode "Normal"; }
		bind "h" "Left" { Resize "Increase Left"; }
		bind "j" "Down" { Resize "Increase Down"; }
		bind "k" "Up" { Resize "Increase Up"; }
		bind "l" "Right" { Resize "Increase Right"; }
		bind "H" { Resize "Decrease Left"; }
		bind "J" { Resize "Decrease Down"; }
		bind "K" { Resize "Decrease Up"; }
		bind "L" { Resize "Decrease Right"; }
		bind "=" "+" { Resize "Increase"; }
		bind "-" { Resize "Decrease"; }
	}
	scroll {
		// vi-style scrollback (mode-keys vi). tmux: prefix [
		bind "Ctrl s" "Esc" "q" { SwitchToMode "Normal"; }
		bind "e" { EditScrollback; SwitchToMode "Normal"; }
		bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
		bind "G" { ScrollToBottom; SwitchToMode "Normal"; }
		bind "j" "Down" { ScrollDown; }
		bind "k" "Up" { ScrollUp; }
		bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
		bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
		bind "d" { HalfPageScrollDown; }
		bind "u" { HalfPageScrollUp; }
	}
	search {
		bind "Ctrl s" "Esc" "q" { SwitchToMode "Normal"; }
		bind "j" "Down" { ScrollDown; }
		bind "k" "Up" { ScrollUp; }
		bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
		bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
		bind "d" { HalfPageScrollDown; }
		bind "u" { HalfPageScrollUp; }
		bind "n" { Search "down"; }
		bind "p" { Search "up"; }
		bind "c" { SearchToggleOption "CaseSensitivity"; }
		bind "w" { SearchToggleOption "Wrap"; }
		bind "o" { SearchToggleOption "WholeWord"; }
	}
	entersearch {
		bind "Ctrl s" "Esc" { SwitchToMode "Scroll"; }
		bind "Enter" { SwitchToMode "Search"; }
	}
	renametab {
		bind "Ctrl c" "Esc" { SwitchToMode "Normal"; }
	}
	renamepane {
		bind "Ctrl c" "Esc" { SwitchToMode "Normal"; }
	}

	shared_except "locked" {
		// THE prefix: Ctrl a from anywhere enters tmux mode.
		bind "Ctrl a" { SwitchToMode "Tmux"; }
		// Ctrl g -> Locked mode is the F12 nested-session toggle analog.
		bind "Ctrl g" { SwitchToMode "Locked"; }
		// tmux: S-Left/S-Right previous/next window — switch tabs globally,
		// no prefix needed.
		bind "Shift Left" { GoToPreviousTab; }
		bind "Shift Right" { GoToNextTab; }
	}
	shared_except "normal" "locked" "tmux" {
		bind "Enter" "Esc" { SwitchToMode "Normal"; }
	}
}

plugins {
	tab-bar { path "tab-bar"; }
	status-bar { path "status-bar"; }
	strider { path "strider"; }
	compact-bar { path "compact-bar"; }
}

// On terminal close, detach rather than kill the session (matches tmux's
// persistent-session feel).
on_force_close "detach"

// Simplified UI without arrow/powerline fonts — keeps the status bar minimal
// like our tmux status line.
simplified_ui true

// tmux: set -g mouse on
mouse_mode true

// No pane frames — our tmux setup has no per-pane borders/titles.
pane_frames false

// tmux: set -g history-limit 20000
scroll_buffer_size 20000

// Use the login shell, same as tmux (set-option -g default-shell $SHELL).
// default_shell "$SHELL"

// Put the status bar at the bottom (tmux: status-position bottom).
default_layout "compact"

// A theme that works on the default/transparent background like our tmux
// status-style (bg=default). Override freely.
theme "catppuccin-mocha"
